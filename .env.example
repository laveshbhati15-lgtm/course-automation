# Course Automation Configuration Template
# Copy this file to .env and customize for your environment.

# AI Provider Configuration (Optional: gemini, none)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=~/.course_automation/browser_profile
# Optional: connect to an existing browser via Chrome DevTools Protocol (CDP)
# e.g., http://127.0.0.1:9222
BROWSER_CDP_URL=

# Local Database & Storage
DATABASE_PATH=~/.course_automation/progress.db

# Execution Settings
LOG_LEVEL=INFO
DRY_RUN=false
