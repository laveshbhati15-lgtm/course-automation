# Course Automation Configuration Template
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# ==============================================================================
# AI Provider Configuration (Optional)
# ==============================================================================
# Supported values: gemini, none (defaults to none if no API key is provided)
AI_PROVIDER=none

# Google Gemini API key (supports GEMINI_API_KEY or GOOGLE_API_KEY)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (e.g., gemini-flash-lite-latest, gemini-flash-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# ==============================================================================
# Browser Configuration
# ==============================================================================
# Set to true to run Playwright in headless mode (default: false for visual verification)
BROWSER_HEADLESS=false

# Persistent directory for browser cookies and authenticated session storage
BROWSER_USER_DATA_DIR=~/.course_automation/browser_profile

# Optional: Connect to an existing running Chrome instance over Chrome DevTools Protocol (CDP)
# e.g., http://127.0.0.1:9222 (leave empty to use local persistent browser profile)
BROWSER_CDP_URL=

# Default timeout in milliseconds for navigation and page actions
BROWSER_TIMEOUT_MS=30000

# ==============================================================================
# Local Database & Checkpointing
# ==============================================================================
# Local SQLite database path for course progress, syllabus structure, and run logs
DATABASE_PATH=~/.course_automation/progress.db

# ==============================================================================
# Execution & Safety Defaults
# ==============================================================================
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Default dry-run mode (set to true to inspect pages without submitting any actions)
DRY_RUN=false
